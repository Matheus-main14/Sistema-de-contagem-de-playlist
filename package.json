{
  "name": "painel-playlist",
  "version": "1.0.0",
  "description": "Painel de Músicas de uma Playlist - HTML, Tailwind CSS e JavaScript",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./src/output.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "serve": "serve . -l 8080",
    "dev": "tailwindcss -i ./src/input.css -o ./src/output.css --watch & serve . -l 8080"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "serve": "^14.2.0",
    "tailwindcss": "^4.3.3"
  }
}
